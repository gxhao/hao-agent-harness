# Reference only: the server does not automatically load .env files.
HTTP_ADDR=127.0.0.1:8080
METRICS_ADDR=127.0.0.1:9090
CLIENT_API_KEYS=replace-with-a-strong-client-token
# Optional overrides; the default config is configs/models.json.
# MODEL_CONFIG_PATH=configs/models.json
# Only needed when api_key_env in a provider references this variable.
# UPSTREAM_API_KEY_PRIMARY=replace-with-your-provider-key
# Optional; only used when a model provider uses auth_type: openai_oauth.
OPENAI_OAUTH_TOKEN_FILE=
# Optional; used by --login and auth_type: openai_codex.
OPENAI_CODEX_TOKEN_FILE=
MAX_REQUEST_BYTES=1048576
MAX_CONCURRENT_REQUESTS=64
REQUEST_TIMEOUT=120s
UPSTREAM_HEADER_TIMEOUT=30s
STREAM_FIRST_EVENT_TIMEOUT=30s
STREAM_IDLE_TIMEOUT=30s
DOWNSTREAM_WRITE_TIMEOUT=15s
SHUTDOWN_TIMEOUT=30s
LOG_LEVEL=info
